package web

import (
	"github.com/saku75/warren/internal/core/tree"
	"github.com/saku75/warren/internal/db/gen"
	"github.com/saku75/warren/internal/dcim"
)

// siteGroupSelect picks a site group from the tree.
templ siteGroupSelect(flat []tree.Flat[gen.SiteGroup], selectedID string) {
	@treeSelect("group", flat, siteGroupOptID, siteGroupOptName, selectedID)
}

func siteGroupOptID(g gen.SiteGroup) string   { return g.ID.String() }
func siteGroupOptName(g gen.SiteGroup) string { return g.Name }

templ statusSelect(selected string) {
	<select name="status">
		for _, st := range dcim.Statuses {
			<option value={ st } selected?={ st == selected }>{ st }</option>
		}
	</select>
}

templ tenantSelect(tenants []gen.ListTenantsRow, selectedSlug string) {
	<select name="tenant">
		<option value="">— none —</option>
		for _, t := range tenants {
			<option value={ t.Slug } selected?={ t.Slug == selectedSlug }>{ t.Name }</option>
		}
	</select>
}

templ kindSelect(selected string) {
	<select name="kind">
		for _, k := range dcim.LocationKinds {
			<option value={ k } selected?={ k == selected }>{ k }</option>
		}
	</select>
}

// SitesPage is the full sites list page.
templ SitesPage(items []gen.ListSitesRow, errMsg string) {
	@Layout("Sites", "sites") {
		<header class="page-header">
			<h1>Sites</h1>
			<div class="page-actions">
				<a class="btn" href="/dcim/sites/new">Add site</a>
			</div>
		</header>
		@SitesSection(items, errMsg)
	}
}

templ SitesSection(items []gen.ListSitesRow, errMsg string) {
	<section id="sites-section">
		@Alert(errMsg)
		<div class="card table-card">
			<table class="objects">
				<thead>
					<tr><th>Name</th><th>Slug</th><th>Status</th><th>Group</th><th>Tenant</th><th></th></tr>
				</thead>
				<tbody>
					if len(items) == 0 {
						<tr><td colspan="6" class="empty">No sites yet — <a href="/dcim/sites/new">add the first one</a>.</td></tr>
					}
					for _, s := range items {
						<tr>
							<td><a class="obj-link" href={ templ.URL("/dcim/sites/" + s.Slug) }>{ s.Name }</a></td>
							<td><code>{ s.Slug }</code></td>
							<td>
								@StatusBadge(s.Status)
							</td>
							<td>
								if s.GroupName != nil {
									{ *s.GroupName }
								} else {
									<span class="muted">—</span>
								}
							</td>
							<td>
								if s.TenantSlug != nil {
									<a href={ templ.URL("/tenancy/tenants/" + *s.TenantSlug) }>
										if s.TenantName != nil {
											{ *s.TenantName }
										} else {
											{ *s.TenantSlug }
										}
									</a>
								} else {
									<span class="muted">—</span>
								}
							</td>
							<td class="row-actions">
								<button
									class="btn btn-ghost-danger btn-small"
									hx-delete={ "/dcim/sites/" + s.Slug }
									hx-target="#sites-section"
									hx-swap="outerHTML"
									hx-confirm={ "Delete site " + s.Name + " and its locations?" }
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// SiteFormPage is the standalone create form. in carries submitted values
// back into the form when validation fails.
templ SiteFormPage(in dcim.SiteInput, tenants []gen.ListTenantsRow, groups []tree.Flat[gen.SiteGroup], errMsg string) {
	@Layout("Add site", "sites") {
		<nav class="crumbs"><a href="/dcim/sites">Sites</a> <span>/</span> <span>Add</span></nav>
		<header class="page-header">
			<h1>Add site</h1>
		</header>
		@Alert(errMsg)
		<section class="card form-card">
			<form method="post" action="/dcim/sites">
				@CSRFField()
				<div class="form-grid">
					<label>
						Name
						<input type="text" name="name" value={ in.Name } required placeholder="Copenhagen DC 1" data-slug-source/>
					</label>
					@SlugField(in.Slug, false)
					<label>
						Status
						@statusSelect(in.Status)
					</label>
					<label>
						Group
						@siteGroupSelect(groups, in.GroupRef)
					</label>
					<label>
						Tenant
						@tenantSelect(tenants, in.TenantRef)
					</label>
					<label>
						Facility
						<input type="text" name="facility" value={ in.Facility }/>
					</label>
					<label>
						Time zone
						<input type="text" name="time_zone" value={ in.TimeZone } placeholder="Europe/Copenhagen"/>
					</label>
					<label class="span-2">
						Description
						<input type="text" name="description" value={ in.Description }/>
					</label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn">Create site</button>
					<a class="btn btn-ghost" href="/dcim/sites">Cancel</a>
				</div>
			</form>
		</section>
	}
}

// SiteDetailPage shows one site: facts, edit form, and its location tree.
// groupPath/groupName are empty when the site has no group.
templ SiteDetailPage(site gen.Site, tenantSlug string, tenants []gen.ListTenantsRow, groupPath string, groupName string, groups []tree.Flat[gen.SiteGroup], locTree []*tree.Node[gen.Location], errMsg string) {
	@Layout(site.Name, "sites") {
		<nav class="crumbs"><a href="/dcim/sites">Sites</a> <span>/</span> <span>{ site.Name }</span></nav>
		<header class="page-header">
			<h1>
				{ site.Name }
				@StatusBadge(site.Status)
			</h1>
			<div class="page-actions">
				<button
					class="btn btn-ghost-danger"
					hx-delete={ "/dcim/sites/" + site.Slug }
					hx-confirm={ "Delete site " + site.Name + " and its locations?" }
				>Delete</button>
			</div>
		</header>
		@Alert(errMsg)
		<div class="cols">
			<div class="col-stack">
				<section class="card">
					<header class="card-head"><h2>Details</h2></header>
					<dl class="facts">
						<dt>Reference</dt><dd><code>{ "dcim.site:" + site.Slug }</code></dd>
						<dt>ID</dt><dd><code>{ site.ID.String() }</code></dd>
						if groupPath != "" {
							<dt>Group</dt><dd><a href={ templ.URL("/dcim/site-groups/" + groupPath) }>{ groupName }</a></dd>
						}
						if site.Facility != "" {
							<dt>Facility</dt><dd>{ site.Facility }</dd>
						}
						if site.TimeZone != "" {
							<dt>Time zone</dt><dd>{ site.TimeZone }</dd>
						}
						<dt>Created</dt><dd>{ site.CreatedAt.Format("2006-01-02 15:04") }</dd>
						<dt>Updated</dt><dd>{ site.UpdatedAt.Format("2006-01-02 15:04") }</dd>
					</dl>
				</section>
				<section class="card">
					<header class="card-head"><h2>Edit</h2></header>
					<form method="post" action={ templ.URL("/dcim/sites/" + site.Slug) }>
				@CSRFField()
						<div class="form-grid">
							<label>
								Name
								<input type="text" name="name" value={ site.Name } required data-slug-source/>
							</label>
							@SlugField(site.Slug, true)
							<label>
								Status
								@statusSelect(site.Status)
							</label>
							<label>
								Group
								@siteGroupSelect(groups, derefID(site.SiteGroupID))
							</label>
							<label>
								Tenant
								@tenantSelect(tenants, tenantSlug)
							</label>
							<label>
								Facility
								<input type="text" name="facility" value={ site.Facility }/>
							</label>
							<label>
								Time zone
								<input type="text" name="time_zone" value={ site.TimeZone } placeholder="Europe/Copenhagen"/>
							</label>
							<label class="span-2">
								Description
								<input type="text" name="description" value={ site.Description }/>
							</label>
						</div>
						<div class="form-actions">
							<button type="submit" class="btn">Save changes</button>
						</div>
					</form>
				</section>
			</div>
			<section class="card">
				<header class="card-head">
					<h2>Locations</h2>
					<a class="card-link" href={ templ.URL("/dcim/sites/" + site.Slug + "/locations/new") }>Add location</a>
				</header>
				if len(locTree) == 0 {
					<p class="empty">No locations yet — model the buildings, floors, and rows here.</p>
				} else {
					@LocationTreeList(locTree)
				}
			</section>
		</div>
	}
}

// LocationTreeList renders the nested location tree.
templ LocationTreeList(nodes []*tree.Node[gen.Location]) {
	<ul class="loc-tree">
		for _, n := range nodes {
			<li>
				<a class="obj-link" href={ templ.URL("/dcim/locations/" + n.Path) }>{ n.Item.Name }</a>
				@KindChip(n.Item.Kind)
				@StatusBadge(n.Item.Status)
				if len(n.Children) > 0 {
					@LocationTreeList(n.Children)
				}
			</li>
		}
	</ul>
}
