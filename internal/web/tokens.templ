package web

import "github.com/saku75/warren/internal/db/gen"

// TokensPage manages the signed-in user's API tokens. newToken is the
// just-created plaintext, shown exactly once after a create.
templ TokensPage(items []gen.ApiToken, newToken string, errMsg string) {
	@Layout("API tokens", "") {
		<header class="page-header">
			<h1>API tokens</h1>
		</header>
		@Alert(errMsg)
		if newToken != "" {
			<div class="card token-reveal">
				<p>Token created — copy it now, it will not be shown again:</p>
				<code class="token-value">{ newToken }</code>
			</div>
		}
		<section id="tokens-section">
			<div class="card table-card">
				<table class="objects">
					<thead>
						<tr><th>Name</th><th>Created</th><th>Expires</th><th>Last used</th><th></th></tr>
					</thead>
					<tbody>
						if len(items) == 0 {
							<tr><td colspan="5" class="empty">No tokens yet — create one below to use the REST API.</td></tr>
						}
						for _, t := range items {
							<tr>
								<td>{ t.Name }</td>
								<td class="muted">{ t.CreatedAt.Format("2006-01-02 15:04") }</td>
								<td class="muted">
									if t.ExpiresAt != nil {
										{ t.ExpiresAt.Format("2006-01-02") }
									} else {
										never
									}
								</td>
								<td class="muted">
									if t.LastUsedAt != nil {
										{ t.LastUsedAt.Format("2006-01-02 15:04") }
									} else {
										never
									}
								</td>
								<td class="row-actions">
									<button
										class="btn btn-ghost-danger btn-small"
										hx-delete={ "/profile/tokens/" + t.ID.String() }
										hx-confirm={ "Revoke token " + t.Name + "?" }
									>Revoke</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<details class="card add-card" open?={ errMsg != "" }>
				<summary>Create token</summary>
				<form method="post" action="/profile/tokens">
					@CSRFField()
					<div class="form-grid">
						<label>
							Name
							<input type="text" name="name" required placeholder="automation"/>
						</label>
						<label>
							Expires after (days, empty = never)
							<input type="number" name="expires_days" min="1" max="3650"/>
						</label>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn">Create token</button>
					</div>
				</form>
			</details>
		</section>
	}
}
