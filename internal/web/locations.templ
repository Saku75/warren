package web

import (
	"github.com/saku75/warren/internal/core/tree"
	"github.com/saku75/warren/internal/db/gen"
	"github.com/saku75/warren/internal/dcim"
)

// LocationFormPage is the standalone create form for a location within
// site. in carries submitted values back when validation fails.
templ LocationFormPage(site gen.Site, in dcim.LocationInput, flat []tree.Flat[gen.Location], errMsg string) {
	@Layout("Add location", "sites") {
		<nav class="crumbs">
			<a href="/dcim/sites">Sites</a> <span>/</span>
			<a href={ templ.URL("/dcim/sites/" + site.Slug) }>{ site.Name }</a> <span>/</span>
			<span>Add location</span>
		</nav>
		<header class="page-header">
			<h1>Add location to { site.Name }</h1>
		</header>
		@Alert(errMsg)
		<section class="card form-card">
			<form method="post" action={ templ.URL("/dcim/sites/" + site.Slug + "/locations") }>
				<div class="form-grid">
					<label>
						Name
						<input type="text" name="name" value={ in.Name } required placeholder="Building A" data-slug-source/>
					</label>
					@SlugField(in.Slug, false)
					<label>
						Kind
						@kindSelect(in.Kind)
					</label>
					<label>
						Status
						@statusSelect(in.Status)
					</label>
					<label>
						Parent
						<select name="parent">
							<option value="">— site root —</option>
							for _, f := range flat {
								<option value={ f.Node.Item.ID.String() } selected?={ f.Node.Item.ID.String() == in.ParentRef }>{ f.Indent() + f.Node.Item.Name }</option>
							}
						</select>
					</label>
					<label class="span-2">
						Description
						<input type="text" name="description" value={ in.Description }/>
					</label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn">Create location</button>
					<a class="btn btn-ghost" href={ templ.URL("/dcim/sites/" + site.Slug) }>Cancel</a>
				</div>
			</form>
		</section>
	}
}

// LocationDetailPage shows one location with its children.
templ LocationDetailPage(loc gen.Location, path string, site gen.Site, children []gen.Location, errMsg string) {
	@Layout(loc.Name, "sites") {
		<nav class="crumbs">
			<a href="/dcim/sites">Sites</a> <span>/</span>
			<a href={ templ.URL("/dcim/sites/" + site.Slug) }>{ site.Name }</a> <span>/</span>
			<span>{ loc.Name }</span>
		</nav>
		<header class="page-header">
			<h1>
				{ loc.Name }
				@KindChip(loc.Kind)
				@StatusBadge(loc.Status)
			</h1>
			<div class="page-actions">
				<button
					class="btn btn-ghost-danger"
					hx-delete={ "/dcim/locations/" + path }
					hx-confirm={ "Delete location " + loc.Name + "?" }
				>Delete</button>
			</div>
		</header>
		@Alert(errMsg)
		<div class="cols">
			<div class="col-stack">
				<section class="card">
					<header class="card-head"><h2>Details</h2></header>
					<dl class="facts">
						<dt>Reference</dt><dd><code>{ "dcim.location:" + path }</code></dd>
						<dt>ID</dt><dd><code>{ loc.ID.String() }</code></dd>
						<dt>Site</dt><dd><a href={ templ.URL("/dcim/sites/" + site.Slug) }>{ site.Name }</a></dd>
						<dt>Created</dt><dd>{ loc.CreatedAt.Format("2006-01-02 15:04") }</dd>
						<dt>Updated</dt><dd>{ loc.UpdatedAt.Format("2006-01-02 15:04") }</dd>
					</dl>
				</section>
				<section class="card">
					<header class="card-head"><h2>Edit</h2></header>
					<form method="post" action={ templ.URL("/dcim/locations/" + path) }>
						<div class="form-grid">
							<label>
								Name
								<input type="text" name="name" value={ loc.Name } required data-slug-source/>
							</label>
							@SlugField(loc.Slug, true)
							<label>
								Kind
								@kindSelect(loc.Kind)
							</label>
							<label>
								Status
								@statusSelect(loc.Status)
							</label>
							<label class="span-2">
								Description
								<input type="text" name="description" value={ loc.Description }/>
							</label>
						</div>
						<div class="form-actions">
							<button type="submit" class="btn">Save changes</button>
						</div>
					</form>
				</section>
			</div>
			<section class="card">
				<header class="card-head"><h2>Children</h2></header>
				if len(children) == 0 {
					<p class="empty">No child locations.</p>
				} else {
					<ul class="loc-tree">
						for _, c := range children {
							<li>
								<a class="obj-link" href={ templ.URL("/dcim/locations/" + path + "/" + c.Slug) }>{ c.Name }</a>
								@KindChip(c.Kind)
								@StatusBadge(c.Status)
							</li>
						}
					</ul>
				}
			</section>
		</div>
	}
}
