package web

// Layout is the application shell: sidebar navigation plus a content
// column. section marks the active nav entry ("dashboard", "tenants",
// "sites", "changelog", or "" for none).
templ Layout(title string, section string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Warren</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body>
			<div class="shell">
				<aside class="sidebar">
					<a class="brand" href="/">
						<span class="brand-mark">W</span>
						<span>Warren</span>
					</a>
					<nav class="side-nav">
						@navLink("/", "Dashboard", section == "dashboard")
						<span class="nav-group">Organization</span>
						@navLink("/tenancy/tenants", "Tenants", section == "tenants")
						@navLink("/tenancy/tenant-groups", "Tenant groups", section == "tenant-groups")
						<span class="nav-group">DCIM</span>
						@navLink("/dcim/sites", "Sites", section == "sites")
						@navLink("/dcim/site-groups", "Site groups", section == "site-groups")
						<span class="nav-group">System</span>
						@navLink("/changelog", "Changelog", section == "changelog")
					</nav>
				</aside>
				<main class="content">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ navLink(href string, label string, active bool) {
	<a href={ templ.URL(href) } class={ "nav-link", templ.KV("active", active) }>{ label }</a>
}

// Alert renders an error banner.
templ Alert(msg string) {
	if msg != "" {
		<div class="alert" role="alert">{ msg }</div>
	}
}

// StatusBadge renders a colored status chip.
templ StatusBadge(status string) {
	<span class={ "badge", "badge-" + status }>{ status }</span>
}

// KindChip renders a location kind label.
templ KindChip(kind string) {
	<span class="chip">{ kind }</span>
}

// SlugField is the slug input used in every create/edit form. It pairs
// with a name input marked data-slug-source: the slug auto-fills while it
// matches what the name generates, sticks once customized, and the ↻
// button re-derives it from the name on demand (see assets/app.js).
templ SlugField(value string, required bool) {
	<label>Slug
		<span class="slug-row">
			<input
				type="text"
				name="slug"
				value={ value }
				data-slug-target
				required?={ required }
				placeholder="derived from name"
			/>
			<button type="button" class="btn-regen" data-slug-regen title="Regenerate slug from name" aria-label="Regenerate slug from name">&#8635;</button>
		</span>
	</label>
}

// ErrorPage is the full-page error fallback.
templ ErrorPage(msg string) {
	@Layout("Error", "") {
		<header class="page-header">
			<h1>Something went wrong</h1>
		</header>
		@Alert(msg)
		<p><a href="/">Back to the dashboard</a></p>
	}
}
