package web

// Home is the placeholder landing page for Phase 0.
templ Home(version string) {
	@Layout("Home") {
		<section class="hero">
			<h1>Warren</h1>
			<p>Infrastructure resource modeling: datacenter infrastructure and IP address management.</p>
			<p class="meta">version { version } · phase 0 — foundations</p>
		</section>
	}
}
