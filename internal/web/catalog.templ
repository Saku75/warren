		</header>
		<section id="module-types-section">
			@Alert(errMsg)
			<div class="card table-card">
				<table class="objects">
					<thead><tr><th>Model</th><th>Manufacturer</th><th>Part number</th><th></th></tr></thead>
					<tbody>
						if len(items) == 0 {
							<tr><td colspan="4" class="empty">No module types yet — <a href="/dcim/module-types/new">add the first one</a>.</td></tr>
						}
						for _, mt := range items {
							<tr>
								<td><a class="obj-link" href={ templ.URL("/dcim/module-types/" + mt.ManufacturerSlug + "/" + mt.Slug) }>{ mt.Model }</a></td>
								<td><a href={ templ.URL("/dcim/manufacturers/" + mt.ManufacturerSlug) }>{ mt.ManufacturerName }</a></td>
								<td class="muted">{ mt.PartNumber }</td>
								<td class="row-actions">
									<button class="btn btn-ghost-danger btn-small" hx-delete={ "/dcim/module-types/" + mt.ManufacturerSlug + "/" + mt.Slug } hx-target="#module-types-section" hx-swap="outerHTML" hx-confirm={ "Delete module type " + mt.Model + "?" }>Delete</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

