// ModuleTypeDetailPage shows one module type with its templates —
// including module-bay templates, which is what lets modules nest.
templ ModuleTypeDetailPage(mt gen.ModuleType, m gen.Manufacturer, templates []gen.ComponentTemplate, errMsg string) {
	@Layout(mt.Model, "module-types") {
		<nav class="crumbs"><a href="/dcim/module-types">Module types</a> <span>/</span> <span>{ mt.Model }</span></nav>
		<header class="page-header">
			<h1>{ mt.Model }</h1>
			<div class="page-actions">
				<button class="btn btn-ghost-danger" hx-delete={ "/dcim/module-types/" + m.Slug + "/" + mt.Slug } hx-confirm={ "Delete module type " + mt.Model + " and its templates?" }>Delete</button>
			</div>
		</header>
		@Alert(errMsg)
		<div class="cols">
			<div class="col-stack">
				<section class="card">
					<header class="card-head"><h2>Details</h2></header>
					<dl class="facts">
						<dt>Reference</dt><dd><code>{ "dcim.module-type:" + m.Slug + "/" + mt.Slug }</code></dd>
						<dt>ID</dt><dd><code>{ mt.ID.String() }</code></dd>
						<dt>Manufacturer</dt><dd><a href={ templ.URL("/dcim/manufacturers/" + m.Slug) }>{ m.Name }</a></dd>
						if mt.PartNumber != "" {
							<dt>Part number</dt><dd>{ mt.PartNumber }</dd>
						}
						<dt>Created</dt><dd>{ mt.CreatedAt.Format("2006-01-02 15:04") }</dd>
					</dl>
				</section>
				<section class="card">
					<header class="card-head"><h2>Edit</h2></header>
					<form method="post" action={ templ.URL("/dcim/module-types/" + m.Slug + "/" + mt.Slug) }>
						@CSRFField()
						<div class="form-grid">
							<label>
								Model
								<input type="text" name="model" value={ mt.Model } required data-slug-source/>
							</label>
							@SlugField(mt.Slug, true)
							<label>
								Part number
								<input type="text" name="part_number" value={ mt.PartNumber }/>
							</label>
							<label class="span-2">
								Description
								<input type="text" name="description" value={ mt.Description }/>
							</label>
						</div>
						<div class="form-actions"><button type="submit" class="btn">Save changes</button></div>
					</form>
				</section>
			</div>
			@TemplatesCard("/dcim/module-types/"+m.Slug+"/"+mt.Slug, templates, errMsg)
		</div>
	}
}

// TemplatesCard renders an owner's component templates with an add form.
// ownerPath is the owning type's UI path; template mutations post to
// ownerPath/templates and deletes to /dcim/component-templates/{id}.
templ TemplatesCard(ownerPath string, templates []gen.ComponentTemplate, errMsg string) {
	<section class="card">
		<header class="card-head"><h2>Component templates</h2></header>
		if len(templates) == 0 {
			<p class="empty">No templates — components added here are stamped onto every new device or installed module.</p>
		} else {
			<table class="objects">
				<thead><tr><th>Kind</th><th>Name</th><th>Attributes</th><th></th></tr></thead>
				<tbody>
					for _, t := range templates {
						<tr>
							<td>
								@KindChip(t.Kind)
							</td>
							<td>
								{ t.Name }
								if t.Label != "" {
									<span class="muted">{ " (" + t.Label + ")" }</span>
								}
							</td>
							<td class="muted">{ summarizeAttrs(t) }</td>
							<td class="row-actions">
								<button class="btn btn-ghost-danger btn-small" hx-delete={ "/dcim/component-templates/" + t.ID.String() + "?back=" + ownerPath } hx-confirm={ "Delete template " + t.Name + "?" }>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<details class="add-card add-inline" open?={ errMsg != "" }>
			<summary>Add template</summary>
			<form method="post" action={ templ.URL(ownerPath + "/templates") }>
				@CSRFField()
				<div class="form-grid">
					<label>
						Kind
						<select name="kind">
							for _, k := range dcim.ComponentKinds {
								<option value={ k }>{ k }</option>
							}
						</select>
					</label>
					<label>
						Name
						<input type="text" name="name" required placeholder="Te{module}/1 or GigabitEthernet1/0/1"/>
					</label>
					<label>
						Label
						<input type="text" name="label"/>
					</label>
					<label>
						Type <span class="muted">(interface/console/power kinds)</span>
						<input type="text" name="attr_type" placeholder="10gbase-x-sfpp"/>
					</label>
					<label>
						Position <span class="muted">(module bays)</span>
						<input type="text" name="attr_position" placeholder="1"/>
					</label>
				</div>
				<div class="form-actions"><button type="submit" class="btn">Add template</button></div>
			</form>
		</details>
	</section>
}

func summarizeAttrs(t gen.ComponentTemplate) string {
	a, err := dcim.UnmarshalAttrs(t.Attrs)
	if err != nil {
		return ""
	}
	out := ""
	if a.Type != "" {
		out += "type=" + a.Type + " "
	}
	if a.Position != "" {
		out += "position=" + a.Position + " "
	}
	if a.MgmtOnly {
		out += "mgmt-only "
	}
	if a.MaxDrawW > 0 {
		out += fmt.Sprintf("max=%dW ", a.MaxDrawW)
	}
	if a.FeedLeg != "" {
		out += "leg=" + a.FeedLeg + " "
	}
	return out
}
