package web

import "github.com/saku75/warren/internal/db/gen"

// TenantsPage is the full tenants list page.
templ TenantsPage(items []gen.Tenant, errMsg string) {
	@Layout("Tenants", "tenants") {
		<header class="page-header">
			<h1>Tenants</h1>
		</header>
		@TenantsSection(items, errMsg)
	}
}

// TenantsSection is the swappable list + create form. UI mutations target
// this section so htmx swaps keep the page state consistent.
templ TenantsSection(items []gen.Tenant, errMsg string) {
	<section id="tenants-section">
		@Alert(errMsg)
		<div class="card table-card">
			<table class="objects">
				<thead>
					<tr><th>Name</th><th>Slug</th><th>Description</th><th></th></tr>
				</thead>
				<tbody>
					if len(items) == 0 {
						<tr><td colspan="4" class="empty">No tenants yet — add the first one below.</td></tr>
					}
					for _, t := range items {
						<tr>
							<td><a class="obj-link" href={ templ.URL("/tenancy/tenants/" + t.Slug) }>{ t.Name }</a></td>
							<td><code>{ t.Slug }</code></td>
							<td class="muted">{ t.Description }</td>
							<td class="row-actions">
								<button
									class="btn btn-ghost-danger btn-small"
									hx-delete={ "/tenancy/tenants/" + t.Slug }
									hx-target="#tenants-section"
									hx-swap="outerHTML"
									hx-confirm={ "Delete tenant " + t.Name + "?" }
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<details class="card add-card" open?={ errMsg != "" }>
			<summary>Add tenant</summary>
			<form
				method="post"
				action="/tenancy/tenants"
				hx-post="/tenancy/tenants"
				hx-target="#tenants-section"
				hx-swap="outerHTML"
			>
				<div class="form-grid">
					<label>Name <input type="text" name="name" required placeholder="Lund Networks" data-slug-source/></label>
					@SlugField("", false)
					<label class="span-2">Description <input type="text" name="description"/></label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn">Create tenant</button>
				</div>
			</form>
		</details>
	</section>
}

// TenantDetailPage shows and edits one tenant.
templ TenantDetailPage(t gen.Tenant, errMsg string) {
	@Layout(t.Name, "tenants") {
		<nav class="crumbs"><a href="/tenancy/tenants">Tenants</a> <span>/</span> <span>{ t.Name }</span></nav>
		<header class="page-header">
			<h1>{ t.Name }</h1>
			<div class="page-actions">
				<button
					class="btn btn-ghost-danger"
					hx-delete={ "/tenancy/tenants/" + t.Slug }
					hx-confirm={ "Delete tenant " + t.Name + "?" }
				>Delete</button>
			</div>
		</header>
		@Alert(errMsg)
		<div class="cols">
			<section class="card">
				<header class="card-head"><h2>Details</h2></header>
				<dl class="facts">
					<dt>Reference</dt><dd><code>{ "tenancy.tenant:" + t.Slug }</code></dd>
					<dt>ID</dt><dd><code>{ t.ID.String() }</code></dd>
					<dt>Created</dt><dd>{ t.CreatedAt.Format("2006-01-02 15:04") }</dd>
					<dt>Updated</dt><dd>{ t.UpdatedAt.Format("2006-01-02 15:04") }</dd>
				</dl>
			</section>
			<section class="card">
				<header class="card-head"><h2>Edit</h2></header>
				<form method="post" action={ templ.URL("/tenancy/tenants/" + t.Slug) }>
					<div class="form-grid">
						<label>Name <input type="text" name="name" value={ t.Name } required data-slug-source/></label>
						@SlugField(t.Slug, true)
						<label class="span-2">Description <input type="text" name="description" value={ t.Description }/></label>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn">Save changes</button>
					</div>
				</form>
			</section>
		</div>
	}
}
