package web

import (
	"github.com/saku75/warren/internal/core/tree"
	"github.com/saku75/warren/internal/db/gen"
	"github.com/saku75/warren/internal/tenancy"
)

// tenantParentSelect picks a parent tenant from the hierarchy.
templ tenantParentSelect(flat []tree.Flat[gen.Tenant], selectedID string) {
	@treeSelect("parent", flat, tenantOptID, tenantOptName, selectedID)
}

func tenantOptID(t gen.Tenant) string   { return t.ID.String() }
func tenantOptName(t gen.Tenant) string { return t.Name }

// TenantsPage shows the tenant hierarchy.
templ TenantsPage(roots []*tree.Node[gen.Tenant], errMsg string) {
	@Layout("Tenants", "tenants") {
		<header class="page-header">
			<h1>Tenants</h1>
			<div class="page-actions">
				<a class="btn" href="/tenancy/tenants/new">Add tenant</a>
			</div>
		</header>
		@TenantsSection(roots, errMsg)
	}
}

// TenantsSection is the swappable tree section.
templ TenantsSection(roots []*tree.Node[gen.Tenant], errMsg string) {
	<section id="tenants-section">
		@Alert(errMsg)
		<div class="card">
			if len(roots) == 0 {
				<p class="empty">No tenants yet — <a href="/tenancy/tenants/new">add the first one</a>.</p>
			} else {
				@TenantTreeList(roots)
			}
		</div>
	</section>
}

templ TenantTreeList(nodes []*tree.Node[gen.Tenant]) {
	<ul class="loc-tree">
		for _, n := range nodes {
			<li>
				<a class="obj-link" href={ templ.URL("/tenancy/tenants/" + n.Item.Slug) }>{ n.Item.Name }</a>
				<code>{ n.Item.Slug }</code>
				if n.Item.Description != "" {
					<span class="muted">{ n.Item.Description }</span>
				}
				if len(n.Children) > 0 {
					@TenantTreeList(n.Children)
				}
			</li>
		}
	</ul>
}

// TenantFormPage is the standalone create form. in carries submitted
// values back into the form when validation fails.
templ TenantFormPage(in tenancy.Input, parents []tree.Flat[gen.Tenant], errMsg string) {
	@Layout("Add tenant", "tenants") {
		<nav class="crumbs"><a href="/tenancy/tenants">Tenants</a> <span>/</span> <span>Add</span></nav>
		<header class="page-header">
			<h1>Add tenant</h1>
		</header>
		@Alert(errMsg)
		<section class="card form-card">
			<form method="post" action="/tenancy/tenants">
				<div class="form-grid">
					<label>
						Name
						<input type="text" name="name" value={ in.Name } required placeholder="Lund Networks" data-slug-source/>
					</label>
					@SlugField(in.Slug, false)
					<label>
						Parent tenant
						@tenantParentSelect(parents, in.ParentRef)
					</label>
					<label class="span-2">
						Description
						<input type="text" name="description" value={ in.Description }/>
					</label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn">Create tenant</button>
					<a class="btn btn-ghost" href="/tenancy/tenants">Cancel</a>
				</div>
			</form>
		</section>
	}
}

// TenantDetailPage shows and edits one tenant. parentSlug/parentName are
// empty when the tenant has no parent.
templ TenantDetailPage(t gen.Tenant, parentSlug string, parentName string, parents []tree.Flat[gen.Tenant], children []gen.Tenant, errMsg string) {
	@Layout(t.Name, "tenants") {
		<nav class="crumbs"><a href="/tenancy/tenants">Tenants</a> <span>/</span> <span>{ t.Name }</span></nav>
		<header class="page-header">
			<h1>{ t.Name }</h1>
			<div class="page-actions">
				<button
					class="btn btn-ghost-danger"
					hx-delete={ "/tenancy/tenants/" + t.Slug }
					hx-confirm={ "Delete tenant " + t.Name + "?" }
				>Delete</button>
			</div>
		</header>
		@Alert(errMsg)
		<div class="cols">
			<div class="col-stack">
				<section class="card">
					<header class="card-head"><h2>Details</h2></header>
					<dl class="facts">
						<dt>Reference</dt><dd><code>{ "tenancy.tenant:" + t.Slug }</code></dd>
						<dt>ID</dt><dd><code>{ t.ID.String() }</code></dd>
						if parentSlug != "" {
							<dt>Parent</dt><dd><a href={ templ.URL("/tenancy/tenants/" + parentSlug) }>{ parentName }</a></dd>
						}
						<dt>Created</dt><dd>{ t.CreatedAt.Format("2006-01-02 15:04") }</dd>
						<dt>Updated</dt><dd>{ t.UpdatedAt.Format("2006-01-02 15:04") }</dd>
					</dl>
				</section>
				<section class="card">
					<header class="card-head"><h2>Edit</h2></header>
					<form method="post" action={ templ.URL("/tenancy/tenants/" + t.Slug) }>
						<div class="form-grid">
							<label>
								Name
								<input type="text" name="name" value={ t.Name } required data-slug-source/>
							</label>
							@SlugField(t.Slug, true)
							<label>
								Parent tenant
								@tenantParentSelect(parents, derefID(t.ParentID))
							</label>
							<label class="span-2">
								Description
								<input type="text" name="description" value={ t.Description }/>
							</label>
						</div>
						<div class="form-actions">
							<button type="submit" class="btn">Save changes</button>
						</div>
					</form>
				</section>
			</div>
			<section class="card">
				<header class="card-head"><h2>Child tenants</h2></header>
				if len(children) == 0 {
					<p class="empty">No child tenants.</p>
				} else {
					<ul class="loc-tree">
						for _, c := range children {
							<li>
								<a class="obj-link" href={ templ.URL("/tenancy/tenants/" + c.Slug) }>{ c.Name }</a>
								<code>{ c.Slug }</code>
							</li>
						}
					</ul>
				}
			</section>
		</div>
	}
}
